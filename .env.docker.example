# Copy to .env in the repo root before `docker compose up`. Never commit the real .env.

# --- API secrets (generate real random values — do not reuse the ones below) ---
# e.g. openssl rand -base64 48
JWT_ACCESS_SECRET=bb7b3abac79b18bd9b364911d81bb7e4
JWT_REFRESH_SECRET=8b3ae69d9be6fca224569ed888121030

# Neon connection string — Dashboard → your project → Connection string → "Direct connection"
# keep Neon credentials secure: do not expose them to client-side code

DATABASE_URL="postgresql://neondb_owner:npg_1YhR6GAiPImV@ep-ancient-silence-aowtezdj-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# The Nginx-fronted public URL of the frontend (used for CORS on the API side)
CORS_ORIGIN=https://sbm-nac.yourdomain.com

# Seed admin — used only the first time you run `docker compose exec api npx prisma db seed`
SEED_ADMIN_EMAIL=admin@sbm-nac.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional — leave blank to disable the NAC sighting-ingest endpoint
NAC_AGENT_SECRET=

# --- Web build args (baked into the client bundle at build time — see apps/web/Dockerfile) ---
# The Nginx-fronted public URL of the API
NEXT_PUBLIC_API_URL=https://api.sbm-nac.yourdomain.com/api/v1
NEXT_PUBLIC_WS_URL=https://api.sbm-nac.yourdomain.com

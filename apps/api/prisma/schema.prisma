// Provider: PostgreSQL (e.g. Neon's free tier — see DEPLOYMENT.md). Originally built against
// SQLite for zero-ops local development; migrated to Postgres so the database can live on a
// managed host independent of wherever the API process runs, which is what makes a free,
// no-credit-card hosting path possible (see DEPLOYMENT.md for why that matters). Fields
// documented with a "///" comment as an enum-like union remain plain String columns rather
// than native Postgres enums — Postgres supports enums, but converting now would touch every
// repository's toDomain() mapping for no functional gain; it's a reasonable future cleanup,
// not a correctness issue today. Their allowed literal values are the single source of truth
// in packages/shared-types/src/enums.ts and are enforced at the application boundary via Zod
// schemas in apps/api/src/presentation/validators.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A dashboard operator account. Single-tenant admin model for v1; role field allows
/// future differentiation (e.g. read-only operators) without a schema change.
model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  /// AdminRole: "ADMIN" | "SUPER_ADMIN"
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  notifications Notification[]
  driveFiles    DriveFile[]     @relation("AdminDriveFiles")

  @@map("admins")
}

/// A self-registered end user (distinct from Admin). Users sign themselves up at /register —
/// nobody types their details in for them — and each registration/login automatically
/// captures a DeviceSession for whatever they connected from. Admins may also provision a
/// User account directly (name/email/password only) for someone who can't self-register;
/// either way, the actual device/session is only ever captured from a real login, never
/// typed in manually. isBlocked cascades from blocking any of this user's sessions — a
/// blocked device blocks the account, not just that one connection.
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  isBlocked    Boolean   @default(false) @map("is_blocked")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens UserRefreshToken[]
  sessions      DeviceSession[]
  driveFiles    DriveFile[]        @relation("UserDriveFiles")

  @@map("users")
}

/// Rotating refresh tokens. Only a hash of the token is stored; the raw token is only ever
/// held client-side in an httpOnly cookie. replacedByTokenId links rotation chains so a
/// reused (stolen) token can be detected and the whole chain revoked.
model RefreshToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique @map("token_hash")
  adminId           String    @map("admin_id")
  admin             Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([adminId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Same shape and purpose as RefreshToken, scoped to User accounts instead of Admin. Kept as
/// a separate model rather than a dual-nullable-FK on RefreshToken so the existing, working
/// admin auth code needed zero changes when self-registration was added.
model UserRefreshToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique @map("token_hash")
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_refresh_tokens")
}

/// Represents a User's device as CURRENTLY connected — this is session state, not a
/// permanent record. A cleanup job deletes any row whose lastActivityAt is older than 30
/// minutes (see infrastructure/sessions/sessionCleanupScheduler.ts), and the portal also
/// deletes its own row immediately when the user explicitly disconnects from the Web Drive.
/// The only thing about a device that outlives this row is a block — see BlockedFingerprint.
model DeviceSession {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A synthetic identifier standing in for a real MAC (browsers cannot expose one — see
  /// infrastructure/auth/deviceFingerprint.ts), stable per (user, browser) pair.
  fingerprint    String
  name           String
  /// DeviceType: "LAPTOP" | "DESKTOP" | "MOBILE" | "IOT" | "SERVER" | "UNKNOWN"
  deviceType     String   @default("UNKNOWN") @map("device_type")
  ipAddress      String   @map("ip_address")
  /// DeviceStatus: "ALLOWED" | "BLOCKED" | "PENDING" — PENDING on every new session, even
  /// for a fingerprint that was previously allowed; only a BLOCK is remembered permanently.
  status         String   @default("PENDING")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([lastActivityAt])
  @@index([fingerprint])
  @@map("device_sessions")
}

/// The one piece of device-level information that IS kept permanently: once a fingerprint
/// is blocked, every future session attempt from it is auto-rejected without needing an
/// admin to block it again, and the User account it belongs to is locked out entirely
/// (User.isBlocked), not just that one session.
model BlockedFingerprint {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  userId      String?  @map("user_id")
  reason      String?
  blockedAt   DateTime @default(now()) @map("blocked_at")

  @@map("blocked_fingerprints")
}

/// A physical or virtual host being monitored. SystemMetric rows are its live/historical
/// telemetry; Device rows may optionally be scoped to the network segment it represents.
model Server {
  id          String    @id @default(cuid())
  name        String
  hostname    String
  ipAddress   String    @unique @map("ip_address")
  location    String?
  description String?
  /// ServerStatus: "ONLINE" | "OFFLINE" | "UNKNOWN"
  status      String    @default("UNKNOWN")
  lastPingAt  DateTime? @map("last_ping_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  metrics SystemMetric[]
  devices Device[]

  @@index([status])
  @@map("servers")
}

/// A single point-in-time resource sample for a server. Written every
/// METRIC_SAMPLE_INTERVAL_MS by the metrics collector and streamed live over WebSocket;
/// also queried historically for the dashboard charts.
model SystemMetric {
  id                 String   @id @default(cuid())
  serverId           String   @map("server_id")
  server             Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpuUsagePercent    Float    @map("cpu_usage_percent")
  ramUsagePercent    Float    @map("ram_usage_percent")
  ramUsedMb          Float    @map("ram_used_mb")
  ramTotalMb         Float    @map("ram_total_mb")
  diskUsagePercent   Float    @map("disk_usage_percent")
  diskUsedGb         Float    @map("disk_used_gb")
  diskTotalGb        Float    @map("disk_total_gb")
  bufferUsagePercent Float    @map("buffer_usage_percent")
  bufferUsedMb       Float    @map("buffer_used_mb")
  bufferTotalMb      Float    @map("buffer_total_mb")
  recordedAt         DateTime @default(now()) @map("recorded_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([serverId, recordedAt])
  @@map("system_metrics")
}

/// A registered network device, identified primarily by MAC address (the NAC unit of
/// identity — an IP can be reassigned by DHCP, a MAC cannot without spoofing). status
/// drives the allow/block decision enforced by the network access control layer. Unrelated
/// to the User portal's DeviceSession below — this model is for admin-managed network
/// hardware (servers, IoT, etc.), not user login sessions.
model Device {
  id           String    @id @default(cuid())
  name         String
  ipAddress    String    @map("ip_address")
  macAddress   String    @unique @map("mac_address")
  /// DeviceType: "LAPTOP" | "DESKTOP" | "MOBILE" | "IOT" | "SERVER" | "UNKNOWN"
  deviceType   String    @default("UNKNOWN") @map("device_type")
  /// DeviceStatus: "ALLOWED" | "BLOCKED" | "PENDING"
  status       String    @default("PENDING")
  serverId     String?   @map("server_id")
  server       Server?   @relation(fields: [serverId], references: [id], onDelete: SetNull)
  lastSeenAt   DateTime? @map("last_seen_at")
  registeredAt DateTime  @default(now()) @map("registered_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  connectionLogs ConnectionLog[]

  @@index([status])
  @@index([ipAddress])
  @@map("devices")
}

/// An immutable audit trail entry for a device's network activity. ipAddress/macAddress
/// are snapshotted at the time of the event (not read live from Device) so history remains
/// accurate even if the device's current IP/MAC record later changes.
model ConnectionLog {
  id         String   @id @default(cuid())
  deviceId   String   @map("device_id")
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ipAddress  String   @map("ip_address")
  macAddress String   @map("mac_address")
  /// ConnectionAction: "CONNECT" | "DISCONNECT" | "BLOCKED" | "ALLOWED" | "ACCESS_ATTEMPT"
  action     String
  /// ConnectionResult: "SUCCESS" | "FAILED"
  result     String
  message    String?
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([deviceId, occurredAt])
  @@index([occurredAt])
  @@map("connection_logs")
}

/// An in-app notification, either targeted at one admin (adminId set) or broadcast to all
/// admins (adminId null). metadata holds a JSON-serialized payload (e.g. { deviceId }) so
/// the frontend can deep-link a notification to the resource it concerns.
model Notification {
  id        String   @id @default(cuid())
  adminId   String?  @map("admin_id")
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// NotificationType: "ANOMALY" | "DEVICE_BLOCKED" | "DEVICE_ALLOWED" | "SERVER_OFFLINE" | "THRESHOLD_EXCEEDED" | "SYSTEM" | "INFO"
  type      String
  /// NotificationSeverity: "INFO" | "WARNING" | "CRITICAL"
  severity  String   @default("INFO")
  title     String
  message   String
  metadata  String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId, isRead, createdAt])
  @@map("notifications")
}

/// A generic key-value application setting (e.g. CPU/RAM/disk/buffer alert thresholds,
/// default theme, metric retention window). value is stored as a JSON string so a single
/// table can hold settings of differing shapes without a schema migration per setting.
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("settings")
}

/// A node in the simulated Web Drive file tree. type distinguishes folders (which have
/// children) from files (which have a size/mimeType). The self-relation forms the
/// directory hierarchy; deleting a folder cascades to everything inside it.
///
/// Exactly one of adminOwnerId/userOwnerId is set, never both, never neither — enforced in
/// DriveFileService, not the database (Postgres CHECK constraints aren't modeled in Prisma
/// without raw SQL migrations, and this project's whole read/write path already goes through
/// one service, so the invariant has a single enforcement point regardless).
///
/// Note: the unique([parentId, name]) constraint does not prevent duplicate root-level
/// names (parentId null), since SQL treats each NULL as distinct — duplicate root names
/// are rejected at the application/service layer instead.
model DriveFile {
  id           String      @id @default(cuid())
  name         String
  path         String
  /// DriveFileType: "FILE" | "FOLDER"
  type         String
  mimeType     String?     @map("mime_type")
  sizeBytes    Int         @default(0) @map("size_bytes")
  parentId     String?     @map("parent_id")
  parent       DriveFile?  @relation("DriveFileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     DriveFile[] @relation("DriveFileTree")
  adminOwnerId String?     @map("admin_owner_id")
  adminOwner   Admin?      @relation("AdminDriveFiles", fields: [adminOwnerId], references: [id], onDelete: Cascade)
  userOwnerId  String?     @map("user_owner_id")
  userOwner    User?       @relation("UserDriveFiles", fields: [userOwnerId], references: [id], onDelete: Cascade)
  isPublic     Boolean     @default(false) @map("is_public")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([adminOwnerId])
  @@index([userOwnerId])
  @@unique([parentId, name])
  @@map("drive_files")
}
